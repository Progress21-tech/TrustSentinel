APP_ENV=development
APP_NAME=trustsentinel-backend
APP_VERSION=0.1.0
DATABASE_URL=sqlite:///./trustsentinel.db
MODEL_PATH=models/isolation_forest_v1.joblib
MODEL_VERSION=iforest-v1.1.0
ML_N_ESTIMATORS=200
ML_RANDOM_STATE=2026
ML_CONTAMINATION=auto
ML_MAX_SAMPLES=auto
ML_MAX_FEATURES=1.0
ML_ANOMALY_REASON_THRESHOLD=0.95
ML_HIGH_RISK_THRESHOLD=0.90
RULE_VERSION=rules_v1
RULE_SCORE_WEIGHT=0.7
ML_SCORE_WEIGHT=0.3
RULES_ONLY_FALLBACK=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
API_KEY_SECRET=
SESSION_SIGNING_SECRET=
ANALYST_EMAIL=
ANALYST_PASSWORD_HASH=
RATE_LIMIT_PER_MINUTE=120
