APP_ENV=development
APP_NAME=trustsentinel-backend
APP_VERSION=0.1.0
DATABASE_URL=sqlite:///./trustsentinel.db
MODEL_PATH=models/isolation_forest_v1.joblib
MODEL_VERSION=iforest_v1
